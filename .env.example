# =================================================================
# Конфигурация Avito Manager
# Скопируйте этот файл в .env и укажите ваши собственные данные:
#   cp .env.example .env
# =================================================================

# 1. Токен вашего Telegram-бота (получить в @BotFather)
BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrSTUvwxYZ

# 2. Telegram ID администратора(ов) (узнать свой ID можно в @userinfobot)
# Если администраторов несколько, укажите их через запятую без пробелов: 123456789,987654321
ADMIN_IDS=123456789

# 3. Системные пути (внутри Docker-контейнера)
# Стандартные пути для связки с https://github.com/Duff89/parser_avito
CONFIG_PATH=/opt/parser_avito/config.toml
PARSER_PATH=/opt/parser_avito
PARSER_CONTAINER_NAME=avito
DB_PATH=searches.db
